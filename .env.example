# 第 2 章接真实 judge 才填,本章留空
CHAT_MODEL=
CHAT_BASE_URL=
CHAT_API_KEY=
# 数据库(Ch14):留空 = SQLite(data/eval.db);生产切 PostgreSQL 示例:
#   postgresql+psycopg://evalflow:evalflow@localhost:5432/evalflow
DATABASE_URL=
# embedding(Ollama)与向量库(chroma)
EMBED_BASE_URL=http://localhost:11434
EMBED_MODEL=bge-m3
EMBED_TIMEOUT=120
CHROMA_HOST=
CHROMA_PORT=8000
# Celery 任务队列(Redis broker)
REDIS_URL=redis://localhost:6379/0
RUN_CONCURRENCY=4
# Ch11 LLM 可靠性(都有默认值,一般不用改)
CHAT_RETRIES=3
CHAT_RETRY_BASE=0.5
CHAT_CIRCUIT_FAILURES=5
CHAT_CIRCUIT_COOLDOWN=30
JUDGE_SAMPLES=1
# Ch12 安全与成本
# 平台访问密钥:留空 = 不鉴权(本地 dev);填了则所有接口(除 /health)都要带 Authorization: Bearer <该值>
APP_API_KEY=
# create_run 限流:每分钟最多发起评测次数
RATE_LIMIT_RUNS_PER_MINUTE=10
# 费用统计单价(元/百万 token),deepseek-chat 参考价,按官方实际调
CHAT_PRICE_INPUT_PER_1M=2.0
CHAT_PRICE_OUTPUT_PER_1M=8.0
# Ch14 e2e:端到端测试置 1,替换 LLM/judge 为确定性假实现并同步执行(不烧钱、不起 worker)
E2E_MOCK=

# Ch30 裁判独立配置:留空 = 回退到上面的 CHAT_*(行为不变)
# 单独配是为了能做裁判 A/B —— Ch28 实测换裁判会让指标动 0.3+,而门禁容忍度只有 0.05;
# 裁判模型是「测量仪器」,必须能单独换,也必须记进 run 快照。
# JUDGE_BASE_URL=
# JUDGE_API_KEY=
# JUDGE_MODEL=
